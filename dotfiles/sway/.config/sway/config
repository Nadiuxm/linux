# Sway — configuration personnelle
#
# ATTENTION : dès que ce fichier existe, Sway ignore /etc/sway/config
# ENTIÈREMENT. Il ne fusionne pas les deux. Le include ci-dessous n'est
# donc pas un confort : sans lui, tous les raccourcis par défaut
# disparaissent (terminal, lanceur, sortie de session).
#
# À ne pas confondre avec /etc/sway/config.d/, qui lui est bien fusionné —
# mais qui appartient à root et ne peut donc pas être versionné ici.

include /etc/sway/config


# Disposition du clavier
#
# Sway ne lit PAS /etc/X11/xorg.conf.d/00-keyboard.conf : ce fichier est
# destiné à Xorg. Il ne lit pas non plus les réglages GNOME (gsettings).
# Sans la section ci-dessous, il retombe sur son défaut, US QWERTY.
#
# Vérifier ce que voit Sway :  swaymsg -t get_inputs
# Tester à chaud sans relancer :  swaymsg input type:keyboard xkb_layout fr

input type:keyboard {
    xkb_layout "fr"
    xkb_variant "azerty"
}


# Disposition des écrans
#
# Sway ne connaît ni « écran 1/2/3 » ni « écran principal » : uniquement des
# sorties placées par coordonnées dans un plan virtuel commun. C'est la position
# qui décide de tout, à commencer par le bord par lequel la souris passe.
#
#   HDMI-A-2            DP-3              DP-1
#   P2425H              P2725DE           P2414H
#   1920x1080           2560x1440         1920x1080
#   ┌────────┐      ┌──────────────┐      ┌────────┐
#   │ gauche │      │    centre    │      │ droite │
#   └────────┘      └──────────────┘      └────────┘
#   x=0             x=1920                x=4480
#
# Le y=180 des deux latéraux n'est pas arbitraire : ils font 1080 de haut contre
# 1440 pour le central. (1440-1080)/2 = 180 les centre verticalement au lieu de
# les aligner par le haut — la souris traverse alors sans décrochage.
# Variantes : y=0 aligne les bords hauts, y=360 aligne les bords bas.
#
# Nommage par PORT (DP-3, HDMI-A-2…), choix assumé : le branchement ne bouge pas.
# Si un câble change de prise, ce bloc est à corriger — l'identifiant durable
# serait « marque modèle série », p.ex. "Dell Inc. DELL P2725DE FVTKM84".
# Pour retrouver les noms et l'état réels :  swaymsg -t get_outputs

output HDMI-A-2 position 0 180
output DP-3     position 1920 0
output DP-1     position 4480 180


# Répartition des espaces de travail
#
# Une colonne d'écran par position dans la rangée de chiffres :
#
#     gauche      centre      droite
#     1 4 7 10    2 5 8       3 6 9
#
# La rangée du clavier reproduit la disposition physique du bureau : Super+&
# part à gauche, Super+é au centre, Super+" à droite, puis on recommence. Rien
# à mémoriser, la main sait où elle va.
#
# ATTENTION — ces affectations s'appliquent à la CRÉATION d'un espace, pas au
# rechargement. Un espace déjà ouvert n'est pas déplacé par « swaymsg reload » :
# il faut relancer la session, ou le déplacer à la main :
#     swaymsg 'workspace number 2; move workspace to output DP-3'

workspace 1  output HDMI-A-2
workspace 2  output DP-3
workspace 3  output DP-1
workspace 4  output HDMI-A-2
workspace 5  output DP-3
workspace 6  output DP-1
workspace 7  output HDMI-A-2
workspace 8  output DP-3
workspace 9  output DP-1
workspace 10 output HDMI-A-2

# « Écran principal » n'existant pas côté Wayland, voici ce qui en tient lieu :
# la session démarre sur l'espace 2, donc au centre, et non sur l'espace 1 qui
# est désormais à gauche. En exec et non en commande nue, pour que les sorties
# soient prêtes au moment où elle s'exécute.
exec swaymsg workspace number 2


# ─── Corrections de raccourcis ───────────────────────────────────────────────
#
# Ce bloc vient APRÈS le include, il a donc le dernier mot sur /etc/sway/config.


# 1. Les flèches déplacent la fenêtre, plus le focus
#
# Par défaut Super+flèches fait « focus », en doublon de Super+h/j/k/l. Déplacer
# une fenêtre est plus fréquent que déplacer le focus, donc on échange :
#     flèches  → déplacer la fenêtre     (h/j/k/l gardent le focus)
# Au bord d'un écran, « move » passe la fenêtre sur l'écran voisin.
#
# --no-warn : on réécrit sciemment une liaison existante, sans quoi swaynag
# affiche un avertissement à chaque rechargement.

bindsym --no-warn $mod+Left  move left
bindsym --no-warn $mod+Down  move down
bindsym --no-warn $mod+Up    move up
bindsym --no-warn $mod+Right move right


# 2. Espaces de travail : lier le CODE de touche, pas le symbole
#
# Bug constaté : Super+Maj+& changeait d'espace au lieu d'y envoyer la fenêtre,
# et « envoyer la fenêtre sur l'espace N » était inatteignable au clavier.
#
# Cause : « bindsym $mod+1 » lie le SYMBOLE « 1 ». Sur AZERTY ce symbole exige
# déjà Maj (la touche donne « & » sans Maj). Super+Maj+& produit donc « 1 » et
# déclenche la liaison sans-Maj ; atteindre $mod+Shift+1 demanderait un second
# Maj. Impossible.
#
# Correctif : --to-code traduit le symbole en code de touche physique dans la
# première disposition configurée — man 5 sway : « Bindings to keysyms are
# layout-dependent. This can be changed with the --to-code flag ». C'est la
# touche qui compte, plus le caractère qu'elle produit.
#
# Les anciennes liaisons sont retirées explicitement : une liaison par symbole
# et une liaison par code sont deux objets distincts pour Sway, une simple
# redéfinition les laisserait coexister et se marcher dessus.

unbindsym $mod+1
unbindsym $mod+2
unbindsym $mod+3
unbindsym $mod+4
unbindsym $mod+5
unbindsym $mod+6
unbindsym $mod+7
unbindsym $mod+8
unbindsym $mod+9
unbindsym $mod+0
unbindsym $mod+Shift+1
unbindsym $mod+Shift+2
unbindsym $mod+Shift+3
unbindsym $mod+Shift+4
unbindsym $mod+Shift+5
unbindsym $mod+Shift+6
unbindsym $mod+Shift+7
unbindsym $mod+Shift+8
unbindsym $mod+Shift+9
unbindsym $mod+Shift+0

# Aller sur l'espace N            →  Super + touche du chiffre (sans Maj)
bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+6 workspace number 6
bindsym --to-code $mod+7 workspace number 7
bindsym --to-code $mod+8 workspace number 8
bindsym --to-code $mod+9 workspace number 9
bindsym --to-code $mod+0 workspace number 10

# Y envoyer la fenêtre active     →  Super + Maj + touche du chiffre
bindsym --to-code $mod+Shift+1 move container to workspace number 1
bindsym --to-code $mod+Shift+2 move container to workspace number 2
bindsym --to-code $mod+Shift+3 move container to workspace number 3
bindsym --to-code $mod+Shift+4 move container to workspace number 4
bindsym --to-code $mod+Shift+5 move container to workspace number 5
bindsym --to-code $mod+Shift+6 move container to workspace number 6
bindsym --to-code $mod+Shift+7 move container to workspace number 7
bindsym --to-code $mod+Shift+8 move container to workspace number 8
bindsym --to-code $mod+Shift+9 move container to workspace number 9
bindsym --to-code $mod+Shift+0 move container to workspace number 10


# 3. Cycler entre les fenêtres d'un même espace
#
# En tuilage on se déplace par direction (Super+h/j/k/l), pas par cycle. Mais la
# direction ne dit plus rien dès que les fenêtres se superposent — dispositions
# en onglets (Super+w) ou en piles (Super+s). D'où ce cycle, indépendant de la
# disposition, que Sway fournit sans le lier à quoi que ce soit.
#
# --to-code obligatoire ici, et pour la même raison que pour les chiffres :
# Maj+Tab ne produit pas le symbole « Tab » mais « ISO_Left_Tab ». Une liaison
# par symbole sur $mod+Shift+Tab ne se déclencherait jamais.

bindsym --to-code $mod+Tab       focus next
bindsym --to-code $mod+Shift+Tab focus prev
