# Sway — configuration personnelle
#
# PRINCIPE : Sway ne fait que du TUILAGE. Tout ce qui relève du shell — barre,
# lanceur, fond d'écran, notifications, verrouillage, OSD, capture d'écran,
# menu de session — appartient à Noctalia.
#
# Ce fichier ne s'appuie plus sur /etc/sway/config, et c'est le point le plus
# important à comprendre ici.
#
# Pourquoi. Sway ne sait pas DÉSACTIVER une directive : il n'existe aucun
# « défaire », seulement « en poser une autre par-dessus ». Tant qu'on incluait
# /etc/sway/config, on héritait d'un environnement de bureau complet dont on ne
# voulait pas, et le fichier s'est rempli de contournements :
#
#   - 22 « unbindsym » pour neutraliser les liaisons chiffres par symbole
#   - « bar bar-0 mode invisible » pour masquer swaybar sous la barre Noctalia
#   - « output * bg #000000 » PLUS un « sleep 1 ; pkill -x swaybg », parce que
#     la directive « bg » fait lancer un processus swaybg qui recouvrait le fond
#     d'écran de Noctalia à chaque rechargement
#
# Chacun compensait une ligne du fichier système. Les directives non voulues
# n'étant plus héritées, elles n'ont plus besoin d'être recouvertes : les trois
# contournements ont disparu avec l'include. En particulier, Sway ne reçoit plus
# AUCUNE directive « bg », donc il ne lance plus swaybg du tout — il n'y a plus
# rien à tuer, plus de temporisation, plus de course entre deux surfaces.
#
# Ce que ça coûte, assumé : une mise à jour du paquet sway ne se propage plus
# dans cette configuration. En contrepartie l'environnement est identique quelle
# que soit la distribution, ce qui est le bon compromis pour ce dépôt.
#
# ATTENTION — LA LIGNE À NE JAMAIS PERDRE
#
# La dernière ligne de /etc/sway/config était « include /etc/sway/config.d/* ».
# Abandonner l'include principal sans reprendre CELLE-CI casserait la session :
# c'est elle qui charge 10-systemd-session.conf, donc sway-systemd/session.sh,
# donc la propagation de l'environnement vers systemd et D-Bus (WAYLAND_DISPLAY,
# SWAYSOCK, XDG_CURRENT_DESKTOP), le démarrage de sway-session.target et, par
# ricochet, l'agent SSH et les portails xdg-desktop-portal.
# Ces fichiers appartiennent à root : ils sont inclus, pas versionnés.

include /etc/sway/config.d/*


# ─── Variables ───────────────────────────────────────────────────────────────
#
# Reprises telles quelles de /etc/sway/config. $menu a disparu : le lanceur
# n'est plus wmenu-run mais un panneau Noctalia, appelé en IPC (voir plus bas).

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot


# ─── Clavier ─────────────────────────────────────────────────────────────────
#
# Sway ne lit PAS /etc/X11/xorg.conf.d/00-keyboard.conf : ce fichier est
# destiné à Xorg. Il ne lit pas non plus les réglages GNOME (gsettings).
# Sans la section ci-dessous, il retombe sur son défaut, US QWERTY.
#
# Vérifier ce que voit Sway :  swaymsg -t get_inputs
# Tester à chaud sans relancer :  swaymsg input type:keyboard xkb_layout fr

input type:keyboard {
    xkb_layout "fr"
    xkb_variant "azerty"
}


# ─── Écrans ──────────────────────────────────────────────────────────────────
#
# Sway ne connaît ni « écran 1/2/3 » ni « écran principal » : uniquement des
# sorties placées par coordonnées dans un plan virtuel commun. C'est la position
# qui décide de tout, à commencer par le bord par lequel la souris passe.
#
#   HDMI-A-2            DP-3              DP-1
#   P2425H              P2725DE           P2414H
#   1920x1080           2560x1440         1920x1080
#   ┌────────┐      ┌──────────────┐      ┌────────┐
#   │ gauche │      │    centre    │      │ droite │
#   └────────┘      └──────────────┘      └────────┘
#   x=0             x=1920                x=4480
#
# Le y=180 des deux latéraux n'est pas arbitraire : ils font 1080 de haut contre
# 1440 pour le central. (1440-1080)/2 = 180 les centre verticalement au lieu de
# les aligner par le haut — la souris traverse alors sans décrochage.
# Variantes : y=0 aligne les bords hauts, y=360 aligne les bords bas.
#
# Nommage par PORT (DP-3, HDMI-A-2…), choix assumé : le branchement ne bouge pas.
# Si un câble change de prise, ce bloc est à corriger — l'identifiant durable
# serait « marque modèle série », p.ex. "Dell Inc. DELL P2725DE FVTKM84".
# Pour retrouver les noms et l'état réels :  swaymsg -t get_outputs
#
# Aucune directive « bg » ici, volontairement : le fond d'écran est à Noctalia.

output HDMI-A-2 position 0 180
output DP-3     position 1920 0
output DP-1     position 4480 180


# ─── Répartition des espaces de travail ──────────────────────────────────────
#
# Une colonne d'écran par position dans la rangée de chiffres :
#
#     gauche      centre      droite
#     1 4 7 10    2 5 8       3 6 9
#
# La rangée du clavier reproduit la disposition physique du bureau : la première
# touche part à gauche, la deuxième au centre, la troisième à droite, puis on
# recommence. Rien à mémoriser, la main sait où elle va.
#
# ATTENTION — ces affectations s'appliquent à la CRÉATION d'un espace, pas au
# rechargement. Un espace déjà ouvert n'est pas déplacé par « swaymsg reload » :
# il faut relancer la session, ou le déplacer à la main :
#     swaymsg 'workspace number 2; move workspace to output DP-3'

workspace 1  output HDMI-A-2
workspace 2  output DP-3
workspace 3  output DP-1
workspace 4  output HDMI-A-2
workspace 5  output DP-3
workspace 6  output DP-1
workspace 7  output HDMI-A-2
workspace 8  output DP-3
workspace 9  output DP-1
workspace 10 output HDMI-A-2

# « Écran principal » n'existant pas côté Wayland, voici ce qui en tient lieu :
# la session démarre sur l'espace 2, donc au centre, et non sur l'espace 1 qui
# est désormais à gauche. En exec et non en commande nue, pour que les sorties
# soient prêtes au moment où elle s'exécute.
exec swaymsg workspace number 2


# ─── Apparence des fenêtres ──────────────────────────────────────────────────
#
# Par défaut Sway dessine une bordure « normal » : un liseré de 2 px surmonté
# d'une BARRE DE TITRE affichant le nom de la fenêtre, sur fond bleu (#285577,
# la couleur client.focused par défaut).
#
# Ce titre est écrit par l'application elle-même — « Claude Code » pour le
# terminal quand l'agent tourne, le nom de l'onglet pour Firefox. Le cadre bleu
# n'appartient donc à aucun de ces programmes : c'est Sway qui l'affiche.
# Chercher le réglage du côté de l'application aurait été une impasse.
#
# « pixel 2 » garde le liseré et retire la barre de titre : plus de texte, mais
# la couleur continue d'indiquer quelle fenêtre a le focus — nécessaire en
# tuilage sur trois écrans. Pour tout supprimer : « none » à la place.
#
# ATTENTION — comme « workspace ... output », ces directives sont des règles
# appliquées à la CRÉATION d'une fenêtre : un « swaymsg reload » ne retouche pas
# les fenêtres déjà ouvertes. Pour essayer une valeur à chaud sur tout l'écran,
# c'est un sélecteur qu'il faut, pas la directive :
#     swaymsg '[title=".*"] border pixel 2'    # bordure fine
#     swaymsg '[title=".*"] border none'       # rien du tout
#     swaymsg '[title=".*"] border normal'     # retour au défaut de Sway
#
# En disposition onglets (Super+w) ou piles (Super+s), les titres réapparaissent
# quoi qu'il arrive : ils sont le principe même de ces dispositions, pas la
# bordure des fenêtres.

default_border          pixel 2
default_floating_border pixel 2


# ─── Placement des applications ──────────────────────────────────────────────
#
# On désigne un ESPACE, jamais une sortie. L'espace 6 vit déjà sur DP-1 (bloc
# « workspace ... output » plus haut), donc l'écran de droite : « bureau 6 » et
# « écran de droite » nomment le même endroit, et une seule affectation fait foi.
# Si un écran change de prise un jour, il n'y a que le bloc « output » à corriger.
#
# Espace 6 et non 3 : 3 est le premier espace généraliste de DP-1, la VM le
# partagerait. 6 lui est dédié, et reste atteignable au clavier ($mod+15).
#
# Deux directives, deux rôles distincts :
#   - « assign » place la fenêtre sur l'espace 6 dès sa création, sans qu'elle
#     apparaisse d'abord sur l'espace courant.
#   - « for_window ... focus » lui donne le focus, ce qui bascule l'affichage
#     sur l'espace 6 ET y amène le clavier. C'est la bascule voulue à l'ouverture.
# « assign » seul déposerait la fenêtre sans y aller.
#
# Le critère est « app_id » et non « class » : virt-manager est un client
# Wayland natif. Un client XWayland n'a pas d'app_id et demande « class ».
# Ne pas deviner lequel — le lire sur une fenêtre réellement ouverte :
#     swaymsg -t get_tree | grep -E '"(app_id|class)"'
#
# La règle attrape TOUTES les fenêtres de virt-manager, gestionnaire comme
# consoles de machines : elles partagent le même app_id. Pour ne basculer que
# sur la console d'une machine, il faudrait discriminer par titre — le
# gestionnaire s'appelle « Gestionnaire de machines virtuelles », une console
# « <nom de la VM> sur QEMU/KVM ».
#
# ATTENTION — même piège que « workspace ... output » et « default_border » :
# c'est une règle appliquée à la CRÉATION d'une fenêtre. Un « swaymsg reload »
# ne déplace pas une fenêtre déjà ouverte. Pour celle-là, à la main :
#     swaymsg '[app_id="^virt-manager$"] move to workspace number 6'

assign     [app_id="^virt-manager$"] workspace number 6
for_window [app_id="^virt-manager$"] focus


# ═══ TUILAGE — ce qui reste à Sway ═══════════════════════════════════════════


# --- Lancer, fermer, recharger ---

bindsym $mod+Return  exec $term
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload

# Souris + Super : glisser une fenêtre flottante, clic droit pour redimensionner.
floating_modifier $mod normal


# --- Déplacer le focus et les fenêtres ---
#
# hjkl déplace le FOCUS, les flèches déplacent la FENÊTRE. C'est un écart
# assumé au défaut de Sway, qui liait les flèches au focus en doublon de hjkl :
# déplacer une fenêtre est plus fréquent que déplacer le focus.
# Au bord d'un écran, « move » fait passer la fenêtre sur l'écran voisin.

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Left  move left
bindsym $mod+Down  move down
bindsym $mod+Up    move up
bindsym $mod+Right move right

# Doublons hérités du défaut de Sway : même action que les flèches nues
# ci-dessus. Conservés par habitude ; quatre raccourcis à récupérer si besoin.
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right


# --- Cycler entre les fenêtres d'un même espace ---
#
# En tuilage on se déplace par direction (Super+h/j/k/l), mais la direction ne
# dit plus rien dès que les fenêtres se superposent — onglets (Super+w) ou
# piles (Super+s). D'où ce cycle, que Sway fournit sans le lier par défaut.
#
# --to-code obligatoire ici : Maj+Tab ne produit pas le symbole « Tab » mais
# « ISO_Left_Tab ». Une liaison par symbole sur $mod+Shift+Tab ne se
# déclencherait jamais.

bindsym --to-code $mod+Tab       focus next
bindsym --to-code $mod+Shift+Tab focus prev


# --- Espaces de travail : bindcode, et surtout pas bindsym ---
#
# Trois façons de lier la rangée des chiffres, deux mauvaises. L'historique
# vaut d'être gardé, c'est le piège AZERTY le plus coûteux de cette config.
#
# 1. « bindsym $mod+1 » (le défaut de Sway) lie le SYMBOLE « 1 ». Sur AZERTY ce
#    symbole est au NIVEAU 2 de la touche : elle donne « & » seule et « 1 » avec
#    Maj. Super+Maj+& produit donc « 1 » et déclenchait la liaison sans-Maj ;
#    atteindre $mod+Shift+1 aurait demandé un second Maj. Impossible.
#
# 2. « bindsym --to-code » traduit le symbole en code de touche — mais sans
#    retirer le Maj qu'exige ce symbole. $mod+1 devenait $mod+Shift+AE01, et
#    $mod+Shift+1 la MÊME chose. Les deux liaisons se retrouvaient sur la même
#    combinaison, la première inscrite gagnait. Symptôme observé : Super+touche
#    ne faisait rien, Super+Maj+touche changeait d'espace au lieu d'y envoyer la
#    fenêtre. Le correctif n'avait pas résolu le bug, il l'avait DÉPLACÉ.
#
# 3. « bindcode » prend directement le code de la touche PHYSIQUE, sans passer
#    par un symbole ni par un niveau. Plus d'ambiguïté possible.
#
# Codes lus dans /usr/share/X11/xkb/keycodes/evdev — rangée du haut, de gauche
# à droite : AE01=10, AE02=11 … AE10=19. Sur ce clavier ce sont les touches
# & é " ' ( - è _ ç à, celles qui portent les chiffres 1 à 0.
#
# Leçon générale : un symbole, un code de touche et un niveau sont trois choses
# distinctes. Toute config de WM tuilant écrite pour QWERTY est à relire ainsi.

# Aller sur l'espace N        →  Super + touche du chiffre (sans Maj)
bindcode $mod+10 workspace number 1
bindcode $mod+11 workspace number 2
bindcode $mod+12 workspace number 3
bindcode $mod+13 workspace number 4
bindcode $mod+14 workspace number 5
bindcode $mod+15 workspace number 6
bindcode $mod+16 workspace number 7
bindcode $mod+17 workspace number 8
bindcode $mod+18 workspace number 9
bindcode $mod+19 workspace number 10

# Y envoyer la fenêtre active →  Super + Maj + touche du chiffre
bindcode $mod+Shift+10 move container to workspace number 1
bindcode $mod+Shift+11 move container to workspace number 2
bindcode $mod+Shift+12 move container to workspace number 3
bindcode $mod+Shift+13 move container to workspace number 4
bindcode $mod+Shift+14 move container to workspace number 5
bindcode $mod+Shift+15 move container to workspace number 6
bindcode $mod+Shift+16 move container to workspace number 7
bindcode $mod+Shift+17 move container to workspace number 8
bindcode $mod+Shift+18 move container to workspace number 9
bindcode $mod+Shift+19 move container to workspace number 10


# --- Dispositions ---

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space       focus mode_toggle
bindsym $mod+a           focus parent


# --- Scratchpad ---
#
# Le défaut de Sway le liait à $mod+minus / $mod+Shift+minus. Sur AZERTY
# « minus » est le niveau 1 de AE06 — la touche du 6. Deux liaisons se
# disputaient donc la même touche physique et l'espace 6 ne répondait plus.
#
# Réattribué sur « ² » (TLDE, code 49), touche libre, isolée en haut à gauche
# et hors de la rangée des chiffres — plus aucune collision possible.

bindcode $mod+Shift+49 move scratchpad
bindcode $mod+49       scratchpad show


# --- Mode redimensionnement ---

mode "resize" {
    bindsym $left  resize shrink width 10px
    bindsym $down  resize grow height 10px
    bindsym $up    resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left  resize shrink width 10px
    bindsym Down  resize grow height 10px
    bindsym Up    resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"


# ═══ NOCTALIA — tout le reste ════════════════════════════════════════════════
#
# Shell Wayland complet : barre, lanceur, notifications, fond d'écran, OSD,
# verrouillage, menu de session. Installé le 2026-09-01 (transaction 10), hors
# protocole de baseline mais après sa capture, donc sans la polluer.
# En version beta, risque accepté : ce n'est pas le compositeur, s'il tombe
# Sway continue de tuiler.
#
# POURQUOI LES RACCOURCIS RESTENT ICI ET NON DANS NOCTALIA.
# Noctalia n'a aucun système de raccourcis — son settings.toml ne contient que
# [theme] et [wallpaper.*]. C'est normal : sous Wayland, seul le compositeur voit
# le clavier. Le partage est donc : Sway capte la FRAPPE, Noctalia fournit le
# COMPORTEMENT et l'AFFICHAGE (l'OSD notamment). Les lignes ci-dessous sont des
# appels IPC, pas des implémentations.
#
# Aucun binaire de sous-commande : tout passe par « noctalia msg ».
# Les 112 commandes :        noctalia msg --help
# Aide d'une commande :      noctalia msg session --help
# Panneaux disponibles :     clipboard, control-center, launcher, polkit,
#                            session, setup-wizard, test, tray-drawer, wallpaper

exec noctalia --daemon

# Lanceur d'applications — remplace wmenu-run.
bindsym $mod+d exec noctalia msg panel-toggle launcher

# Menu de session — remplace le swaynag « do you really want to exit sway ».
# Le panneau couvre lock, suspend, logout, reboot, shutdown. Autres actions
# directes si besoin un jour :
#     noctalia msg session <suspend|lock-and-suspend|logout|reboot|shutdown>
bindsym $mod+Shift+e exec noctalia msg panel-toggle session

# Verrouillage direct, sans passer par le panneau.
#
# POURQUOI PAS Super+L, LE RÉFLEXE WINDOWS.
# « l » est $right dans ce fichier : $mod+l est déjà « focus right » et
# $mod+Shift+l « move right ». Les libérer casserait la symétrie hjkl, qui est
# un choix assumé plus haut. Ctrl+Alt+L est l'autre convention répandue — GNOME,
# Xfce et Cinnamon la lient toutes — donc la mémoire musculaire reste valable
# ailleurs, y compris sur les postes administrés.
#
# À NOTER SUR ALT. Sway ne distingue pas l'Alt gauche du droit : les deux sont
# Mod1. Ce qui les sépare ici, c'est la disposition AZERTY, où l'Alt droit est
# AltGr (ISO_Level3_Shift) et non Mod1 — un effet du clavier, pas du
# compositeur. Ne pas transposer ce raisonnement sur une disposition QWERTY.
#
# Pas de --locked : verrouiller un écran déjà verrouillé n'a pas de sens.
bindsym Control+Mod1+l exec noctalia msg session lock

# Son et luminosité — remplacent les appels directs à pactl et brightnessctl.
# Le gain n'est pas la commande mais l'OSD : Noctalia affiche le niveau, ce que
# pactl ne faisait pas. --locked : actif écran verrouillé.
bindsym --locked XF86AudioMute        exec noctalia msg volume-mute
bindsym --locked XF86AudioLowerVolume exec noctalia msg volume-down
bindsym --locked XF86AudioRaiseVolume exec noctalia msg volume-up
bindsym --locked XF86AudioMicMute     exec noctalia msg mic-mute
bindsym --locked XF86MonBrightnessDown exec noctalia msg brightness-down
bindsym --locked XF86MonBrightnessUp   exec noctalia msg brightness-up

# Capture d'écran — remplace « grim » nu, qui écrivait un PNG dans le dossier
# courant sans rien afficher. Print prend l'écran focalisé, Maj+Print ouvre la
# sélection interactive de zone.
bindsym Print       exec noctalia msg screenshot-fullscreen
bindsym Shift+Print exec noctalia msg screenshot-region
